+static int
+native_gpu_bundle_unprotect_one(const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error == ENOENT) {
+		return 0;
+	}
+	if (error) {
+		return error;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_flags);
+	error = vnode_getattr(vp, &va, ctx);
+	if (!error && (va.va_flags & SF_RESTRICTED)) {
+		uint32_t flags = va.va_flags & ~SF_RESTRICTED;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_flags, flags);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	int xerr = vn_removexattr(vp, "com.apple.rootless", XATTR_NOSECURITY, ctx);
+	if (xerr && xerr != ENOATTR && xerr != ENOTSUP && !error) {
+		error = xerr;
+	}
+	vnode_put(vp);
+	return error;
+}
