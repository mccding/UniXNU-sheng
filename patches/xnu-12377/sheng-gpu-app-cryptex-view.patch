+/*
+ * gpu-app-view=1: union-mount /private/var/ngpu/app-library over /System/Volumes/Preboot/Cryptexes/App/System/Library and
+ * symlink only the two Mach-Os in /Library/GPUBundles/NativeAdrenoMetal.bundle/Contents/MacOS/ to the Frameworks directory inside
+ * that App cryptex view (matching the WebKit GPU/WebContent and replayd sandbox allow-list while keeping SIP enabled and the bundle
+ * metadata trusted under /Library/GPUBundles).
+ */
+volatile int native_gpu_app_view_stage = 0;
+volatile int native_gpu_app_view_status = -1;
+volatile int native_gpu_app_view_links = 0;
+volatile int native_gpu_app_view_link_error = 0;
+static void
+native_owner_macos_gpu_app_cryptex_view(proc_t p, user_addr_t scratch)
+{
+	if (!native_gpu_app_view_wanted()) {
+		return;
+	}
+	static const char app_source[] = "/private/var/ngpu/app-library";
+	static const char app_point[] = "/System/Volumes/Preboot/Cryptexes/App/System/Library";
+	static const char *const stage1_files[] = {
+		"/private/var/ngpu/app-library/Frameworks/NativeAdrenoMetal.bundle/Contents/MacOS/NativeAdrenoMetal",
+		"/private/var/ngpu/app-library/Frameworks/NativeAdrenoMetal.bundle/Contents/MacOS/libvulkan_freedreno.dylib",
+		"/private/var/ngpu/app-library/Frameworks/NativeAdrenoMetal.publish",
+	};
+	static const char *const stage4_checks[] = {
+		"/Applications/Safari.app/Contents/Info.plist",
+		"/System/Volumes/Preboot/Cryptexes/App/System/Library/Frameworks/NativeAdrenoMetal.bundle/Contents/MacOS/NativeAdrenoMetal",
+		"/System/Volumes/Preboot/Cryptexes/App/System/Library/Frameworks/NativeAdrenoMetal.bundle/Contents/MacOS/libvulkan_freedreno.dylib",
+		"/System/Volumes/Preboot/Cryptexes/App/System/Library/Frameworks/NativeAdrenoMetal.publish",
+	};
+	static const char *const machos[] = {"NativeAdrenoMetal", "libvulkan_freedreno.dylib"};
+	vfs_context_t ctx = vfs_context_current();
+	vfs_context_t kctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error = 0;
+	native_gpu_app_view_links = 0;
+	native_gpu_app_view_link_error = 0;
+
+	for (size_t i = 0; i < sizeof(stage1_files) / sizeof(stage1_files[0]); ++i) {
+		error = vnode_lookup(stage1_files[i], VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+		if (!error) {
+			if (vnode_vtype(vp) != VREG) {
+				error = ENOTDIR;
+			}
+			vnode_put(vp);
+		}
+		if (error) {
+			goto out;
+		}
+	}
+	native_gpu_app_view_stage = 1;
+
+	error = vnode_lookup(app_point, 0, &vp, ctx);
+	if (!error) {
+		if (vnode_vtype(vp) != VDIR) {
+			error = ENOTDIR;
+		}
+		vnode_put(vp);
+	}
+	if (error) {
+		goto out;
+	}
+	native_gpu_app_view_stage = 2;
+
+	error = native_cryptex_os_bind(p, scratch, app_source, app_point, MNT_UNION);
+	if (error) {
+		goto out;
+	}
+	native_gpu_app_view_stage = 3;
+
+	for (size_t i = 0; i < sizeof(stage4_checks) / sizeof(stage4_checks[0]); ++i) {
+		error = vnode_lookup(stage4_checks[i], 0, &vp, ctx);
+		if (error) {
+			goto out;
+		}
+		vnode_put(vp);
+	}
+	native_gpu_app_view_stage = 5;
+
+	static const char macos_dir[] = "/Library/GPUBundles/NativeAdrenoMetal.bundle/Contents/MacOS";
+	int lerr = native_gpu_addon_parents(p, scratch, "/Library/GPUBundles/NativeAdrenoMetal.bundle/Contents/MacOS/x");
+	if (!lerr) {
+		lerr = native_gpu_bundle_unprotect_one(macos_dir);
+	}
+	for (size_t i = 0; !lerr && i < sizeof(machos) / sizeof(machos[0]); ++i) {
+		char link_path[192], target[192], existing[256];
+		snprintf(link_path, sizeof(link_path), "%s/%s", macos_dir, machos[i]);
+		snprintf(target, sizeof(target),
+		    "/System/Volumes/Preboot/Cryptexes/App/System/Library/Frameworks/NativeAdrenoMetal.bundle/Contents/MacOS/%s", machos[i]);
+		bool matches = false;
+		vnode_t lvp = NULLVP;
+		if (!vnode_lookup(link_path, VNODE_LOOKUP_NOFOLLOW, &lvp, kctx)) {
+			if (vnode_vtype(lvp) == VLNK) {
+				uio_t luio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+				if (luio) {
+					uio_addiov(luio, CAST_USER_ADDR_T(existing), sizeof(existing) - 1);
+					if (!VNOP_READLINK(lvp, luio, kctx) && uio_resid(luio) >= 0) {
+						size_t len = (size_t)(sizeof(existing) - 1 - uio_resid(luio));
+						if (len == strlen(target) && !memcmp(existing, target, len)) {
+							matches = true;
+						}
+					}
+					uio_free(luio);
+				}
+			}
+			vnode_put(lvp);
+		}
+		if (matches) {
+			(void)native_gpu_bundle_protect_one(link_path);
+			native_gpu_app_view_links++;
+			continue;
+		}
+		lerr = native_gpu_bundle_unprotect_one(link_path);
+		if (!lerr) {
+			struct unlink_args uargs = {.path = scratch + 0xc00};
+			int32_t ures = 0;
+			lerr = copyout(link_path, uargs.path, strlen(link_path) + 1);
+			if (!lerr) {
+				lerr = unlink(p, &uargs, &ures);
+				if (lerr == ENOENT) {
+					lerr = 0;
+				}
+			}
+		}
+		if (!lerr) {
+			struct symlink_args sargs = {.path = scratch + 0xc00, .link = scratch + 0xd80};
+			int32_t sres = 0;
+			lerr = copyout(target, sargs.path, strlen(target) + 1);
+			if (!lerr) {
+				lerr = copyout(link_path, sargs.link, strlen(link_path) + 1);
+			}
+			if (!lerr) {
+				lerr = symlink(p, &sargs, &sres);
+			}
+		}
+		if (!lerr) {
+			vnode_t resolved = NULLVP;
+			lerr = vnode_lookup(link_path, 0, &resolved, ctx);
+			if (!lerr) {
+				vnode_put(resolved);
+				native_gpu_app_view_links++;
+			}
+		}
+		(void)native_gpu_bundle_protect_one(link_path);
+	}
+	int perr = native_gpu_bundle_protect_one(macos_dir);
+	if (!lerr && perr) {
+		lerr = perr;
+	}
+	native_gpu_app_view_link_error = lerr;
+
+out:
+	native_gpu_app_view_status = error;
+	printf("owner Data: App-cryptex view stage %d status %d, links %d (%d)\n",
+	    native_gpu_app_view_stage, native_gpu_app_view_status, native_gpu_app_view_links, native_gpu_app_view_link_error);
+}
+
 /* gpu-bundle-system=1: 1 both mounts made, 0 not asked, 0x1000 + errno the cover failed, else the errno of the union. */
 volatile int native_gpu_bundle_system_view = 0;
 static void
@@ -9802,6 +10043,9 @@ native_owner_macos_gpu_addon(proc_t p, user_addr_t scratch)
 		native_gpu_bundle_system_view = error ? error : (cover ? 0x1000 + cover : 1);
 		printf("owner Data: GPU bundles over /System/Library/Extensions: %d, /Library/GPUBundles covered: %d\n", error, cover);
 	}
+	if (native_gpu_addon_stage == 5 && native_gpu_bundle_system_view != 1) {
+		native_owner_macos_gpu_app_cryptex_view(p, scratch);
+	}
 	if (native_gpu_addon_stage == 5) {
 		native_owner_macos_gpu_shader_cache(p, scratch, native_gpu_bundle_system_view == 1);
 	}
