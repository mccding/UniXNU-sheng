index 6d38c56..04ac053 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1,3 +1,6 @@
+#if defined(__arm64__)
+#include <console/piano_panic_text.h>
+#endif
 /*
  * Copyright (c) 2000-2020 Apple Inc. All rights reserved.
  *
@@ -1254,6 +1257,9 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 #pragma clang diagnostic pop
 	extern void boot_log_panic_record(const char *, va_list *, unsigned long) __attribute__((weak_import));
 	if (&boot_log_panic_record) boot_log_panic_record(panic_format_str, panic_args, panic_caller);
+#if defined(__arm64__)
+	piano_panic_text_begin();
+#endif
 
 
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
@@ -1393,6 +1399,11 @@ panic_stackshot_release_lock(void)
 static void
 kdp_machine_reboot_type(unsigned int type, uint64_t debugger_flags)
 {
+#if defined(__arm64__)
+	if (type == kPEPanicRestartCPU || type == kPEPanicRestartCPUNoCallouts) {
+		piano_panic_text_draw();
+	}
+#endif
 	if ((type == kPEPanicRestartCPU) && (debugger_flags & DEBUGGER_OPTION_SKIP_PANICEND_CALLOUTS)) {
 		PEHaltRestart(kPEPanicRestartCPUNoCallouts);
 	} else {
