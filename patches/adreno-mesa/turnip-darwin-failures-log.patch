+static void
+darwin_log_failure(const char *op, kern_return_t kr, uint64_t a, uint64_t b)
+{
+   static uint64_t count = 0;
+   const uint64_t n = __atomic_fetch_add(&count, 1, __ATOMIC_RELAXED) + 1;
+   if (n <= 16 || (n & (n - 1)) == 0) {
+      const char *proc = getprogname();
+      os_log_error(OS_LOG_DEFAULT,
+                   "NativeAdreno: %{public}s %{public}s failed: 0x%x (0x%llx, 0x%llx) [#%llu]",
+                   proc ? proc : "?", op, (unsigned)kr,
+                   (unsigned long long)a, (unsigned long long)b,
+                   (unsigned long long)n);
+   }
+}
