+static uint64_t
+darwin_cs_budget(void)
+{
+   static uint64_t budget = UINT64_MAX;
+   if (budget == UINT64_MAX) {
+      const char *text = getenv("TU_DARWIN_CS_RESERVE_MB");
+      const uint64_t mb = text && *text ? strtoull(text, NULL, 10) : (strcmp(getprogname(), "WindowServer") ? 0 : 32);
+      budget = mb << 20;
+   }
+   return budget;
+}
+
+static bool
+darwin_cs_enabled(void)
+{
+   if (!darwin_cs_budget())
+      return false;
+   static uint64_t checked_ns;
+   static bool off;
+   const uint64_t now = os_time_get_nano();
+   if (!checked_ns || now - checked_ns >= 1000000000ull) {
+      struct stat st;
+      off = stat("/private/var/ngpu/debug/no-cs-reserve", &st) == 0;
+      checked_ns = now;
+   }
+   return !off;
+}
+
+static bool
+darwin_cs_put(struct tu_device *dev, struct darwin_retire_state *retire, const struct darwin_retired_bo *bo)
+{
+   const uint64_t budget = darwin_cs_budget();
+   if (!bo->cs || !bo->mapping || bo->size > budget || !darwin_cs_enabled())
+      return false;
+   if (retire->cs_count == retire->cs_capacity) {
+      const unsigned capacity = retire->cs_capacity ? retire->cs_capacity * 2 : 64;
+      struct darwin_cached_bo *grown = (struct darwin_cached_bo *)realloc(retire->cs_reserve, capacity * sizeof(*grown));
+      if (!grown)
+         return false;
+      retire->cs_reserve = grown;
+      retire->cs_capacity = capacity;
+   }
+   retire->cs_reserve[retire->cs_count++] = {bo->handle, bo->iova, bo->size, ++retire->cs_stamp, bo->mapping, bo->token,
+                                             bo->read_only, os_time_get_nano()};
+   retire->cs_bytes += bo->size;
+   ++retire->cs_stats.puts;
+   while (retire->cs_bytes > budget && retire->cs_count > 1) {
+      unsigned oldest = 0;
+      for (unsigned i = 1; i < retire->cs_count; ++i)
+         if (retire->cs_reserve[i].stamp < retire->cs_reserve[oldest].stamp)
+            oldest = i;
+      struct darwin_cached_bo *e = &retire->cs_reserve[oldest];
+      if (darwin_release_native(dev, retire, e->handle, e->iova, e->size, &e->mapping, &e->token) != VK_SUCCESS)
+         break;
+      retire->cs_bytes -= e->size;
+      *e = retire->cs_reserve[--retire->cs_count];
+      ++retire->cs_stats.evictions;
+   }
+   return true;
+}
+
+static bool
+darwin_cs_get(struct darwin_retire_state *retire, uint64_t size, struct darwin_cached_bo *out)
+{
+   int best = -1;
+   for (unsigned i = 0; i < retire->cs_count; ++i) {
+      const struct darwin_cached_bo *e = &retire->cs_reserve[i];
+      if (e->size < size || e->size / 4 > size)
+         continue;
+      if (best < 0 || e->size < retire->cs_reserve[best].size ||
+          (e->size == retire->cs_reserve[best].size && e->stamp > retire->cs_reserve[best].stamp))
+         best = (int)i;
+   }
+   if (best < 0)
+      return false;
+   *out = retire->cs_reserve[best];
+   retire->cs_bytes -= out->size;
+   retire->cs_reserve[best] = retire->cs_reserve[--retire->cs_count];
+   return true;
+}
+
+static void
+darwin_cs_drain(struct tu_device *dev, struct darwin_retire_state *retire)
+{
+   for (unsigned i = retire->cs_count; i-- > 0;) {
+      struct darwin_cached_bo *e = &retire->cs_reserve[i];
+      if (darwin_release_native(dev, retire, e->handle, e->iova, e->size, &e->mapping, &e->token) != VK_SUCCESS)
+         continue;
+      retire->cs_bytes -= e->size;
+      *e = retire->cs_reserve[--retire->cs_count];
+      ++retire->cs_stats.drained;
+   }
+}
+
+static void
+darwin_cs_report_stats(struct darwin_retire_state *retire, bool now_anyway = false)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *text = getenv("TU_DARWIN_BO_REPORT");
+      on = text && *text ? atoi(text) != 0 : !strcmp(getprogname(), "WindowServer");
+   }
+   const uint64_t now = os_time_get_nano();
+   if (!on || (!now_anyway && retire->cs_stats.reported_ns && now - retire->cs_stats.reported_ns < 10000000000ull))
+      return;
+   retire->cs_stats.reported_ns = now;
+   const struct darwin_cs_stats *c = &retire->cs_stats;
+   const struct darwin_bo_cache_stats *st = &retire->cache_stats;
+   os_log(OS_LOG_DEFAULT, "NativeAdreno BO report: cs %llu (reserve %llu, cache mapped %llu, unmapped %llu, new %llu) maps %llu "
+          "(cs %llu) | reserve %s %u BOs %llu KiB of %llu MiB, puts %llu evicted %llu drained %llu | cache lookups %llu hits %llu "
+          "cached %u %llu MiB flushes %llu aged %llu reclaims %llu/%llu | retiring %u",
+          (unsigned long long)c->allocs, (unsigned long long)c->reserve_hits, (unsigned long long)c->cache_mapped,
+          (unsigned long long)c->cache_unmapped, (unsigned long long)c->fresh, (unsigned long long)p_atomic_read(&c->maps),
+          (unsigned long long)p_atomic_read(&c->maps_cs), darwin_cs_enabled() ? "on" : "off", retire->cs_count,
+          (unsigned long long)(retire->cs_bytes >> 10), (unsigned long long)(darwin_cs_budget() >> 20), (unsigned long long)c->puts,
+          (unsigned long long)c->evictions, (unsigned long long)c->drained, (unsigned long long)st->lookups,
+          (unsigned long long)st->hits, retire->cache_count, (unsigned long long)(retire->cache_bytes >> 20),
+          (unsigned long long)st->flushes, (unsigned long long)st->aged, (unsigned long long)st->reclaims_seen,
+          (unsigned long long)st->reclaims_asked, retire->count);
+}
