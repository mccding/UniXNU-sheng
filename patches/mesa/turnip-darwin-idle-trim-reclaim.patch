+/* Retry helper after BoAlloc returns kIOReturnNoMemory: broadcasts gpu-reclaim once and backs off 4, 8, 16, 32, 64 ms while reaping. */
+static uint64_t darwin_retry_failed_ns;
+static bool
+darwin_retry_wait(struct tu_device *dev, struct darwin_retire_state *retire, unsigned retries)
+{
+   if (retries >= 5)
+      return false;
+   if (!retries) {
+      const uint64_t failed = p_atomic_read(&darwin_retry_failed_ns);
+      if (failed && os_time_get_nano() - failed < 1000000000ull)
+         return false;
+      darwin_ask_reclaim(retire);
+   }
+   usleep(4000u << retries);
+   pthread_mutex_lock(&retire->lock);
+   ++retire->cache_stats.retries;
+   if (darwin_reap_locked(dev, retire) == VK_SUCCESS)
+      darwin_cache_trim(dev, retire);
+   pthread_mutex_unlock(&retire->lock);
+   return true;
+}
+
+static void
+darwin_retry_done(struct darwin_retire_state *retire, unsigned retries, bool made)
+{
+   if (!retries)
+      return;
+   static uint64_t outcomes[2];
+   p_atomic_set(&darwin_retry_failed_ns, made ? 0 : os_time_get_nano());
