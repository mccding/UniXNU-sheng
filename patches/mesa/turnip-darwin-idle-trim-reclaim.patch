+/* How long an unused cached BO stays before going back to the kernel (TU_DARWIN_BO_CACHE_AGE_MS, 2000 ms by default; 0: keep). */
+static uint64_t
+darwin_cache_age_ns(void)
+{
+   static uint64_t age = UINT64_MAX;
+   if (age == UINT64_MAX) {
+      const char *text = getenv("TU_DARWIN_BO_CACHE_AGE_MS");
+      age = (text && *text ? strtoull(text, NULL, 10) : 2000) * 1000000ull;
+   }
+   return age;
