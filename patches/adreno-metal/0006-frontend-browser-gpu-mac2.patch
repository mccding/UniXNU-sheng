diff --git a/NativeBridgeMetalFrontend.mm b/NativeBridgeMetalFrontend.mm
index 7b47fda..765dd6f 100644
--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -5611,10 +5611,53 @@ static uint64_t askAnswer(SEL cmd,NSUInteger arg) {
 static NSUInteger countArgAnswer(id,SEL cmd,NSUInteger arg) {return (NSUInteger)askAnswer(cmd,arg);}
 static BOOL flagArgAnswer(id,SEL cmd,NSUInteger arg) {return askAnswer(cmd,arg)!=0;}
 static BOOL (*gFamilyAnswer)(id,SEL,NSInteger);
+enum FamilyCaller {FamilyCallerOther,FamilyCallerRenderBox,FamilyCallerWebGPU,FamilyCallerBrowserGPU};
+// The images that hold ANGLE's Metal display or Dawn's Metal backend (the browsers' GL, WebGL and WebGPU), matched
+// by exact library basename or framework directory: WebKit's ANGLE, a standalone ANGLE or Dawn, and the Chromium frameworks
+// that link both in (Chrome, Chromium, Edge, Brave, Electron apps).
+static bool browserGpuImage(const char *path) {
+ const char *slash=strrchr(path,'/');
+ if(!slash)return false;
+ static const char *const libraries[]={"libANGLE-shared.dylib","libGLESv2.dylib","libwebgpu_dawn.dylib"};
+ for(const char *library:libraries)if(strcmp(slash+1,library)==0)return true;
+ static const char *const frameworks[]={
+  "/Google Chrome Framework.framework/","/Chromium Framework.framework/","/Microsoft Edge Framework.framework/",
+  "/Brave Browser Framework.framework/","/Electron Framework.framework/"};
+ for(const char *framework:frameworks)if(strstr(path,framework))return true;
+ return false;
+}
+// The framework whose code is at a return address, looked up once per address: dladdr searches the image's symbol table, and
+// QuartzCore's pixel-format queries ask supportsFamily: for every surface it makes (a masked corner, a backdrop, a blur's mips) and every
+// IOSurface it checks -- caching avoids repeating dladdr per query.
+static FamilyCaller familyCaller(const void *address) {
+ static std::mutex lock;
+ static std::unordered_map<const void *,FamilyCaller> known;
+ {
+  std::lock_guard<std::mutex> hold(lock);
+  auto it=known.find(address);
+  if(it!=known.end())return it->second;
+ }
+ FamilyCaller kind=FamilyCallerOther;
+ Dl_info caller;
+ if(dladdr(address,&caller) && caller.dli_fname) {
+  if(strstr(caller.dli_fname,"/RenderBox.framework/"))kind=FamilyCallerRenderBox;
+  else if(strstr(caller.dli_fname,"/WebGPU.framework/"))kind=FamilyCallerWebGPU;
+  else if(browserGpuImage(caller.dli_fname))kind=FamilyCallerBrowserGPU;
+ }
+ std::lock_guard<std::mutex> hold(lock);
+ if(known.size()<4096)known.emplace(address,kind);
+ return kind;
+}
+// ANGLE's Metal display exists on macOS only for a default device in MTLGPUFamilyMac2 (IsMetalRendererAvailable), so
+// Chrome's GPU process failed EGL display init without it and lost GL, WebGL and WebGPU; WebKit's ANGLE and WebGPU.framework
+// also gate on family checks. Restrict Mac2 to browser GPU images and Apple4 to WebGPU.framework so WindowServer/QuartzCore/games
+// keep the hardware's native family answers.
 static BOOL familyForCaller(id self,SEL _cmd,NSInteger family) {
- if(family>=1003 && family<2000) {   // MTLGPUFamilyApple3 and up
-  Dl_info caller;
-  if(dladdr(__builtin_return_address(0),&caller) && caller.dli_fname && strstr(caller.dli_fname,"/RenderBox.framework/"))return NO;
+ if((family>=1003 && family<2000) || family==2002) {   // MTLGPUFamilyApple3 to Apple10, MTLGPUFamilyMac2
+  const FamilyCaller kind=familyCaller(__builtin_return_address(0));
+  if(family==2002)return kind==FamilyCallerBrowserGPU ? YES : gFamilyAnswer(self,_cmd,family);
+  if(kind==FamilyCallerRenderBox)return NO;
+  if(kind==FamilyCallerWebGPU && family==1004)return YES;   // MTLGPUFamilyApple4
  }
  return gFamilyAnswer(self,_cmd,family);
 }
