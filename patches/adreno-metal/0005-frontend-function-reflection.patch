+// ---- function reflection (UniXNU-piano tooling/metal/turnip-a830/frontend 0010, 2026-11-22, MIT as the file) ----
+// _MTLFunction's returnType and arguments for a visible (stitchable) function: Core Image's modern CIKL path reflects every kernel of a
+// library it compiled from source (reflect(CIKernelLibrary): returnType's dataType, each argument's type, name and dataTypeDescription,
+// a struct's typeName and members) and without the answers its kernels could not be made. The answers are the
+// function's own: the signature the compiler wrote into its AIR (AirSignature.h reads it from the function's bitcode in its library's
+// metallib), turned into objects as Apple's Metal answers the same compiled function (qualified field by field against Apple's Metal
+// on a Mac). A function whose AIR says nothing of the kind, or holds a type outside that
+// qualified set, answers nil with one line in the log, never a guessed signature.
+#include "AirSignature.h"
+static NSData *functionBitcode(NBFunction *function);
+// A selector these lack is answered nil/0 and noted once, as NBObject's (they derive from Metal's own classes: Core Image tells a
+// struct type from a plain one by its class).
+#define NB_REFLECTION_ANSWERS_MISSING \
+ - (NSMethodSignature *)methodSignatureForSelector:(SEL)selector { \
+  NSMethodSignature *signature=[super methodSignatureForSelector:selector];return signature?signature:missingSignature(self,selector); \
+ } \
+ - (void)forwardInvocation:(NSInvocation *)invocation {answerMissing(invocation);}
+@interface NBFunctionType : MTLType
+@property(nonatomic) MTLDataType nbDataType;
+@end
 @implementation NBFunction
+// _MTLFunction's returnType and arguments (function reflection above): read once from the function's AIR; nil with one log line
+// when it states no visible signature or one outside the qualified set.
+- (void)nb_reflect {
+ @synchronized(self) {
+  if(_nbReflected)return;
+  _nbReflected=YES;
+  id result=nil;NSArray *arguments=nil;std::string why;
+  if(reflectFunction(self,&result,&arguments,why)){_nbReturnType=result;_nbArguments=arguments;return;}
+  static std::atomic<int> told{0};
+  if(told.fetch_add(1)<64)NBLOG(@"native-metal: function reflection: %@: %s (returnType and arguments answered nil)",_name?:@"?",why.c_str());
+ }
+}
+- (id)returnType {[self nb_reflect];return _nbReturnType;}
+- (NSArray *)arguments {[self nb_reflect];return _nbArguments;}
 - (NSString *)formattedDescription:(NSUInteger)indent {
