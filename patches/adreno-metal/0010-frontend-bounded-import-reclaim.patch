+template<class Key,class Value> class HeldImportPolicy {
+ struct Entry {Value value;uint64_t bytes,lastUse,order;};
+ std::map<Key,Entry> entries;
+ uint64_t held=0,sequence=0;
+ void remove(typename std::map<Key,Entry>::iterator it,std::vector<Value> &gone) {
+  gone.push_back(it->second.value);held-=it->second.bytes;entries.erase(it);
+ }
+public:
+ uint64_t bytes() const {return held;}
+ size_t count() const {return entries.size();}
+ template<class Dead> void prune(uint64_t now,uint64_t budget,uint64_t age,bool all,Dead dead,std::vector<Value> &gone) {
+  for(auto it=entries.begin();it!=entries.end();) {
+   auto old=it++;
+   if(all || dead(old->second.value) || (now>=old->second.lastUse && now-old->second.lastUse>=age))remove(old,gone);
+  }
+  while(held>budget && !entries.empty()) {
+   auto oldest=std::min_element(entries.begin(),entries.end(),[](const auto &a,const auto &b){return a.second.order<b.second.order;});
+   remove(oldest,gone);
+  }
+ }
+ void hold(const Key &key,const Value &value,uint64_t bytes,uint64_t now,uint64_t budget,std::vector<Value> &gone) {
+  auto it=entries.find(key);
+  if(it!=entries.end()){it->second.lastUse=now;it->second.order=++sequence;return;}
+  if(!bytes || bytes>budget)return;
+  prune(now,budget-bytes,UINT64_MAX,false,[](const Value &){return false;},gone);
+  entries.emplace(key,Entry{value,bytes,now,++sequence});held+=bytes;
  }
+};
